{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "design-intelligence",
            "tool": "check_ui_task",
            "input": { "prompt": "${prompt}", "cwd": "${cwd}" },
            "timeout": 15,
            "statusMessage": "design-intelligence: checking for UI work"
          }
        ]
      }
    ]
  }
}
