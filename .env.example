# All settings are optional. Defaults are shown.

# Where the SQLite research database and exports live.
# Default: $XDG_DATA_HOME/design-intelligence-mcp or ~/.local/share/design-intelligence-mcp
# (Windows: %LOCALAPPDATA%\design-intelligence-mcp)
# DIM_DATA_DIR=
# DIM_DB_PATH=

# Research crawler behaviour
# DIM_CONCURRENCY=4                 # parallel sources per research job
# DIM_PER_HOST_INTERVAL_MS=1500     # minimum delay between requests to the same host
# DIM_REQUEST_TIMEOUT_MS=15000      # per-request timeout
# DIM_MAX_RETRIES=2                 # retries for network errors, 429 and 5xx
# DIM_MAX_HTML_BYTES=2000000        # response size caps (bytes, after decompression)
# DIM_MAX_CSS_BYTES=1500000
# DIM_MAX_STYLESHEETS=8             # external stylesheets fetched per page
# DIM_REANALYZE_AFTER_DAYS=30       # analyses younger than this are reused, not refetched
# DIM_USER_AGENT="DesignIntelligenceBot/0.1 (+https://github.com/MagicalPee/repoforclaude)"

# Route research traffic through HTTPS_PROXY. Off by default: with a proxy, the proxy
# resolves DNS, so connect-time private-IP checks (DNS-rebinding protection) cannot be
# applied by this server. Only enable it for a proxy you trust.
# DIM_USE_PROXY=false

# Log level for stderr: error | warn | info | debug
# DIM_LOG_LEVEL=info
